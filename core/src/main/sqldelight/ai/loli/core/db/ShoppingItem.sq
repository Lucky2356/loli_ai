-- Списки покупок и чек-листы. list_name — название списка («Покупки», «В дорогу»).
CREATE TABLE shopping_item (
    id TEXT NOT NULL PRIMARY KEY,
    list_name TEXT NOT NULL,
    text TEXT NOT NULL,
    done INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 1,
    synced_updated_at INTEGER
);

CREATE INDEX shopping_item_list_idx ON shopping_item(deleted, list_name, done);

selectActive:
SELECT * FROM shopping_item WHERE deleted = 0 ORDER BY list_name, done ASC, created_at ASC;

selectById:
SELECT * FROM shopping_item WHERE id = ?;

upsert:
INSERT OR REPLACE INTO shopping_item VALUES ?;

selectDirty:
SELECT * FROM shopping_item WHERE dirty = 1;

markSynced:
UPDATE shopping_item SET dirty = 0, synced_updated_at = :updatedAt WHERE id = :id AND updated_at = :updatedAt;

deleteAll:
DELETE FROM shopping_item;
