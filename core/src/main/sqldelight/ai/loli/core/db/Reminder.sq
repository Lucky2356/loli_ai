-- Напоминания. trigger_at — ближайшее время срабатывания (epoch ms, UTC).
-- recurrence — правило повторения (см. ai.loli.core.model.Recurrence), time_zone — IANA зона пользователя.
CREATE TABLE reminder (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    trigger_at INTEGER NOT NULL,
    recurrence TEXT,
    time_zone TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    last_fired_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 1,
    synced_updated_at INTEGER
);

CREATE INDEX reminder_active_idx ON reminder(deleted, active, trigger_at);

selectAll:
SELECT * FROM reminder WHERE deleted = 0 ORDER BY active DESC, trigger_at ASC;

selectActive:
SELECT * FROM reminder WHERE deleted = 0 AND active = 1 ORDER BY trigger_at ASC;

selectById:
SELECT * FROM reminder WHERE id = ?;

upsert:
INSERT OR REPLACE INTO reminder VALUES ?;

selectDirty:
SELECT * FROM reminder WHERE dirty = 1;

markSynced:
UPDATE reminder SET dirty = 0, synced_updated_at = :updatedAt WHERE id = :id AND updated_at = :updatedAt;

deleteAll:
DELETE FROM reminder;
