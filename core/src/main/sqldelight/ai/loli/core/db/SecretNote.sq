-- Секретные заметки: только на этом устройстве (не синхронизируются, не уходят в AI и в поиск).
CREATE TABLE secret_note (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM secret_note ORDER BY updated_at DESC;

insertOrReplace:
INSERT OR REPLACE INTO secret_note VALUES ?;

deleteById:
DELETE FROM secret_note WHERE id = ?;

countAll:
SELECT count(*) FROM secret_note;

deleteAll:
DELETE FROM secret_note;
